b8076819-19fc-44d5-88e3-384c2dbd14e4,2026-01-26T00:07:11.245016,Reddit_Style,17053f8e-83c1-4deb-8b9e-6b564f4fd45b,يا جماعة، قريت عن خدمة العملاء عند البنوك الثانية مثل @ADCB و @EmiratesNBD، وكل الناس تمدح فيهم. تعرفون شو اللي يحصل مع @MashreqBank؟ صار لي فترة أعاني من خدمة العملاء، وكل ما أكلمهم عن مشكلة في التطبيق يقولي يعيد نفس الجملة، بس المشكلة ما تنحل. حتى مرات أرديهم وما حد يرد علي! سمعت إن البنوك الثانية عندهم خدمة عملاء أونلاين تحل المشكلة بسرعة. حد جرب زود ويقدر يأكد؟ كيف تخبرتكم مع البنوك الثانية؟ يمكن صار الوقت أحول حسابي لبنك ثاني؟ أحب أسمع آراءكم، خصوصاً إذا حد جرب خدمة عملاء أفضل.,,b8076819-19fc-44d5-88e3-384c2dbd14e4,None,ar,"[""#\u062e\u062f\u0645\u0629_\u0639\u0645\u0644\u0627\u0621"", ""#\u0628\u0646\u0648\u0643_\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a"", ""#\u062a\u062c\u0631\u0628\u0629_\u0632\u0628\u0648\u0646""]","[""@MashreqBank"", ""@ADCB"", ""@EmiratesNBD""]",Competitor_News,-0.3,False,46
