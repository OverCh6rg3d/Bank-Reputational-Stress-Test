```gitignore
# --- Python Standard ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

# --- Environment & Secrets (CRITICAL) ---
.env
.env.local
.env.*
secrets.yaml
config.yaml
*.key
*.pem

# --- Google Antigravity / Agentic Artifacts ---
# Ignore heavy run logs and recordings to keep repo clean
artifacts/
browser_recordings/
agent_logs/
.antigravity/cache/
.antigravity/sessions/
trace/
logs/

# --- IDE & OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Documentation ---
site/
build/
dist/
